<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FractionBuddy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
    </style>

    <!-- Launch screen: matches the icon, no artificial delay. -->
    <style name="Theme.FractionBuddy.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FractionBuddy</item>
    </style>
</resources>
